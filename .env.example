# ==============================================================================
# AI Coding Interview Copilot - Environment Configuration Template
# IMPORTANT: Copy this file to .env.local for local development. Never commit .env.
# ==============================================================================

# Server / API Port
PORT=4000
NODE_ENV=development

# AI Provider API Keys (Kept exclusively on API server; NEVER exposed to desktop client)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Selected Default Provider (openai | anthropic | google)
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_AI_MODEL=claude-3-5-sonnet-20241022

# Code Sandbox Service URL (Isolated execution environment)
CODE_RUNNER_URL=http://localhost:4100
CODE_RUNNER_SECRET=local-development-secret-change-in-production

# Observability & Rate Limiting (Optional in dev)
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

